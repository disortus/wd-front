            log(`  ⚠️ Non-existent product was accepted`, "yellow");
        }
        
        fs.unlinkSync(testImagePath);
    } catch (error) {
        log(`  ❌ Test error: ${error.message}`, "red");
    }

    // =========================================================================
    // SECTION 3: PRODUCTS UPDATE
    // =========================================================================
